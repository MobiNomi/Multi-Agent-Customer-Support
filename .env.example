# Copy to .env and fill in. Real environment variables override this file.

# --- LLM (Groq) ---
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2

# --- Database ---
# Default: SQLite file at data/support_system.db (absolute path, works from any folder).
# Postgres example: postgresql+psycopg://user:pass@localhost:5432/support
# DATABASE_URL=
SQL_ECHO=false
# Load demo customers/orders on startup when the database is empty.
SEED_DEMO_DATA=true

# --- Conversation memory ---
# sqlite = saved to disk, survives restarts (default). memory = RAM only, wiped on restart.
MEMORY_BACKEND=sqlite
# Default: data/checkpoints.db
# MEMORY_DB_PATH=

# --- Knowledge base (RAG) ---
# Folder of .md / .txt company files. Default: knowledge/
# KNOWLEDGE_DIR=
CHUNK_MAX_CHARS=1200
CHUNK_OVERLAP=150
# How many chunks the search tool returns to the agent.
RETRIEVAL_TOP_K=4

# --- Sign-in ---
# Secret used to sign session tokens. Required in production; without it everyone is signed out
# whenever the server restarts. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=
# How long a sign-in lasts, in minutes (480 = 8 hours).
ACCESS_TOKEN_MINUTES=480
# Wrong passwords allowed before the account is locked, and for how long.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Send the session cookie over HTTPS only. Set to true when deployed with HTTPS.
COOKIE_SECURE=false
# Let new customers create an account on the sign-in page (Free plan).
REGISTRATION_ENABLED=true
# New accounts allowed per IP address per hour (stops bots mass-registering).
REGISTRATIONS_PER_HOUR=5

# --- Guardrails ---
# Safety checks: hide card/CNIC/password numbers, stop instruction-override attempts, refuse off-topic
# requests, limit tickets, and check replies (made-up citations, false refund claims, prompt leaks).
GUARDRAILS_ENABLED=true
# Messages one customer may send per minute.
CHAT_MESSAGES_PER_MINUTE=10
# New tickets one customer can cause per hour (repeats on the same topic reuse the open ticket).
MAX_TICKETS_PER_HOUR=3

# --- Actions ---
# The assistant can propose refunds, order cancellations and email changes; the customer confirms each
# with a button, and refunds also need approval in the staff console (/staff).
# Minutes a proposal waits for the customer's Confirm before it expires.
ACTION_CONFIRM_MINUTES=30

# --- Chat page ---
# Gives the demo accounts (Ali and Sara) their demo password, adds the demo staff account
# (staff@acmecloud.example), and lists them on the sign-in pages. Set to false in production.
DEMO_MODE=true
# Only needed if the chat page is hosted on a different domain from the API.
# CORS_ORIGINS=https://www.example.com

# --- Graph ---
# Rounds of tool calls an agent may make per message before it must answer with what it has.
MAX_TOOL_ROUNDS=4
# Hard safety limit on graph steps per message.
MAX_GRAPH_STEPS=20

# --- Optional: LangSmith tracing ---
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=multi-agent-customer-support
