# Copy to .env and fill in. Real environment variables override this file.

# --- LLM (Groq) ---
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2

# --- Database ---
# Default: SQLite file at data/support_system.db (absolute path, works from any folder).
# Postgres example: postgresql+psycopg://user:pass@localhost:5432/support
# DATABASE_URL=
SQL_ECHO=false
# Load demo customers/orders on startup when the database is empty.
SEED_DEMO_DATA=true

# --- Conversation memory ---
# sqlite = saved to disk, survives restarts (default). memory = RAM only, wiped on restart.
MEMORY_BACKEND=sqlite
# Default: data/checkpoints.db
# MEMORY_DB_PATH=

# --- Knowledge base (RAG) ---
# Folder of .md / .txt company files. Default: knowledge/
# KNOWLEDGE_DIR=
CHUNK_MAX_CHARS=1200
CHUNK_OVERLAP=150
# How many chunks the search tool returns to the agent.
RETRIEVAL_TOP_K=4

# --- Graph ---
# Max node executions per message (stops runaway tool loops).
MAX_GRAPH_STEPS=12

# --- Optional: LangSmith tracing ---
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=multi-agent-customer-support
